@EndUserText.label: 'VIM Document Service'
define service Z_ZFC_VIM_DOC_SRV {
  expose ZC_ZFC_VIM_DOC        as VIMDocument;
  expose ZC_ZFC_VIM_DOC_ITEM   as VIMDocumentItem;
  expose ZC_ZFC_VIM_GR_CE      as GoodsReceipt;
  expose ZC_ZFC_VIM_PO_ITEM_CE as PurchaseOrderItem;
  expose I_Supplier            as Supplier;
  expose I_Currency            as Currency;
  expose I_PaymentTermsText    as PaymentTerms;
  expose ZC_ZFC_VIM_DOC_VH_CE  as VIMDocumentVH;
}